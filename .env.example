# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE_URL: Project URL from your Supabase project dashboard (Settings -> API)
# Example: https://xyzcompany.supabase.co
SUPABASE_URL="https://your-project.supabase.co"

# SUPABASE_ANON_KEY: Public anon API key from Supabase dashboard (Settings -> API)
SUPABASE_ANON_KEY="your-anon-key"

# SUPABASE_SERVICE_ROLE_KEY: (Optional) Secret Service Role Key for backend operations
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
